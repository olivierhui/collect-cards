# Copy to .env after you buy domain + create a Patreon API client.
APP_SECRET=change-me-to-a-long-random-string
APP_PUBLIC_URL=http://127.0.0.1:8788
ADMIN_KEY=change-me

# Leave empty to use mock login (dev). Fill to enable real Patreon OAuth.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=http://127.0.0.1:8788/auth/patreon/callback
PATREON_CAMPAIGN_ID=
PATREON_PAGE_URL=https://www.patreon.com/18animegirls
# Optional. Creator of this campaign is treated as T5 for testing.
PATREON_CREATOR_USER_ID=
PATREON_CREATOR_VANITY=18animegirls

# Optional. Admin save also writes catalog/site.json back to GitHub.
GITHUB_TOKEN=
GITHUB_REPO=olivierhui/collect-cards
GITHUB_BRANCH=main

# Patreon tier IDs from your campaign (not the T3 title — the numeric/string id).
PATREON_TIER_T3=
PATREON_TIER_T4=
PATREON_TIER_T5=
PATREON_TIER_T6=
PATREON_TIER_T7=
